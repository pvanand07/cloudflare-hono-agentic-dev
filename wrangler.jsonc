{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-template",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-15",
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-template-db",
      "database_id": "<run: wrangler d1 create project-template-db>",
      "migrations_dir": "migrations"
    }
  ]
}